{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t3rmo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  // Native rate limiter, per-IP, for room creation. The Worker is stateless
  // between requests, so this needs a binding rather than a variable — and an
  // unauthenticated POST that materialises a Durable Object is exactly what a
  // script would hammer to run up the bill.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "ENTRY_LIMIT", "namespace_id": "1002", "simple": { "limit": 180, "period": 60 } }
  ],
  // No workers.dev URL: the game lives at its own domain, and a *.workers.dev
  // address is an internal-looking second door nobody should bookmark or share.
  "workers_dev": false,
  // Custom domains, not routes: Cloudflare provisions the certificate and the
  // DNS record itself, and the zone is already on elly/rayden nameservers.
  "routes": [
    { "pattern": "t3rmo.com", "custom_domain": true },
    { "pattern": "www.t3rmo.com", "custom_domain": true }
  ]
}
